{
  "name": "@fengyun/nexus-gateway",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude ../../data/** --exclude ../../data/* --exclude **/*.sqlite --exclude **/*.sqlite-* --exclude **/*.db.json --exclude ../../configs/*.local.json --exclude ../../configs/**/*.local.json --exclude ../web/dist/** --exclude ./public/** --exclude ../../plugins/** --exclude ../../**/node_modules/** src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fengyun/nexus-channel": "workspace:*",
    "@fengyun/nexus-core": "workspace:*",
    "@fengyun/nexus-db": "workspace:*",
    "@fengyun/nexus-llm": "workspace:*",
    "@fengyun/nexus-mcp-host": "workspace:*",
    "@fengyun/nexus-plugin-loader": "workspace:*",
    "@fengyun/nexus-plugin-sdk": "workspace:*",
    "@fengyun/nexus-shared": "workspace:*",
    "@fengyun/nexus-workflow": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nanoid": "^5.0.9",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
