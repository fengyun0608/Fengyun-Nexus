{
  "name": "fengyun-nexus",
  "version": "0.2.121",
  "private": true,
  "description": "风云枢纽 Fengyun Nexus — 风云网络出品的本地 AI 对话与自动化枢纽",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "boot": "node scripts/boot.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "smoke": "node scripts/smoke.mjs",
    "dev": "pnpm --filter @fengyun/nexus-gateway dev",
    "dev:web": "pnpm --filter @fengyun/nexus-web dev",
    "dev:all": "pnpm -r --parallel --filter @fengyun/nexus-gateway --filter @fengyun/nexus-web dev",
    "build:packages": "pnpm --filter @fengyun/nexus-shared --filter @fengyun/nexus-core --filter @fengyun/nexus-channel --filter @fengyun/nexus-plugin-sdk --filter @fengyun/browser-shot --filter @fengyun/nexus-db --filter @fengyun/nexus-plugin-loader --filter @fengyun/nexus-llm --filter @fengyun/nexus-workflow --filter @fengyun/nexus-mcp-host build",
    "pack:system-plugins": "node scripts/export-system-plugin-pack.mjs",
    "build": "pnpm run build:packages && pnpm --filter @fengyun/nexus-web build",
    "build:web": "pnpm --filter @fengyun/nexus-web build",
    "start": "pnpm --filter @fengyun/nexus-gateway start",
    "nexus": "pnpm --filter @fengyun/nexus-cli start",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
